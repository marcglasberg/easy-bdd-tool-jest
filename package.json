{
  "name": "easy-bdd-tool-jest",
  "version": "1.2.0",
  "description": "Easy BDD Tool, for Jest. Create your BDD tests directly in code, and get readable error messages. Exports to Gherkin/Cucumber feature files.",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/esm/types/index.d.ts",
        "default": "./lib/esm/index.mjs"
      },
      "require": {
        "types": "./lib/cjs/types/index.d.ts",
        "default": "./lib/cjs/index.js"
      }
    },
    "./jest-reporter": {
      "types": "./lib/cjs/types/jest-reporter.d.ts",
      "default": "./lib/cjs/jest-reporter.js"
    }
  },
  "types": "./lib/cjs/types/index.d.ts",
  "main": "./lib/cjs/index.js",
  "files": [
    "lib/**/*"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "npm run clean && npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p ./tsconfig.esm.json && node -e \"require('fs').rename('lib/esm/index.js', 'lib/esm/index.mjs', (err) => { if (err) throw err; })\"",
    "build:cjs": "tsc -p ./tsconfig.cjs.json",
    "test": "jest",
    "lint": "eslint .",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/marcglasberg/easy-bdd-tool-jest.git"
  },
  "keywords": [
    "bdd",
    "test",
    "testing",
    "jest",
    "tdd",
    "assertion"
  ],
  "author": "Marcelo Glasberg",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/marcglasberg/easy-bdd-tool-jest/issues"
  },
  "homepage": "https://github.com/marcglasberg/easy-bdd-tool-jest#readme",
  "dependencies": {
    "@cucumber/gherkin": "42.0.1",
    "@cucumber/messages": "34.2.1"
  },
  "peerDependencies": {
    "jest": "^29.0.0 || ^30.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.12.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.14",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "unrs-resolver": false
  }
}
